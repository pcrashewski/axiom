---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Kurtyna from '../components/Kurtyna.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Dane strukturalne -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Opifex',
      description: 'Projektowanie i budowa stron internetowych — pełny serwis: projekt, kod, domena i hosting na Cloudflare.',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Polska',
      },
      url: canonicalURL,
    })} />

    <ViewTransitions />
    <!-- Kurtyna: ukryj przez CSS zanim JS wystartuje (tylko powrót / reload) -->
    <script is:inline>
      if(sessionStorage.getItem('kurtyna-v2')){document.documentElement.classList.add('kurtyna-skip')}
    </script>
  </head>
  <body>
    <Kurtyna />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:bg-anthracite focus:text-cream focus:px-4 focus:py-2"
    >
      Przejdź do treści
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ── 1. Linea tracta — kreślenie konturów SVG przy wejściu w widok ──────────
      const obserwatorLinii = new IntersectionObserver(
        (wpisy) => {
          for (const wpis of wpisy) {
            if (wpis.isIntersecting) {
              wpis.target.classList.add('in-conspectu');
              obserwatorLinii.unobserve(wpis.target);
            }
          }
        },
        { threshold: 0 }
      );

      const zaobserwujLinie = () => {
        for (const linia of document.querySelectorAll('.linea-tracta:not(.in-conspectu)')) {
          obserwatorLinii.observe(linia);
        }
      };

      // ── 2. Aktywna sekcja w nawigacji ─────────────────────────────────────────
      const inicjujAktywnyLink = () => {
        const sekcje = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
        const linki = Array.from(document.querySelectorAll<HTMLAnchorElement>('header nav a[href]'));
        if (!sekcje.length || !linki.length) return;

        const obsNav = new IntersectionObserver((wpisy) => {
          for (const wpis of wpisy) {
            if (wpis.isIntersecting) {
              const id = wpis.target.id;
              linki.forEach((link) => {
                const href = link.getAttribute('href') ?? '';
                link.classList.toggle('nav-aktywny', href === `#${id}` || href === `/#${id}`);
              });
            }
          }
        }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });

        sekcje.forEach((s) => obsNav.observe(s));
      };

      // ── 3. Reveal nagłówków — cały h2 wchodzi jako blok (bez podziału na słowa) ─
      const inicjujReveal = () => {
        document.querySelectorAll<HTMLElement>('section h2:not(.h-reveal)').forEach((el) => {
          el.classList.add('h-reveal');
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.92) {
            // Już widoczny przy ładowaniu — pokaż bez animacji
            el.style.transition = 'none';
            el.classList.add('w-polu');
            requestAnimationFrame(() => { el.style.transition = ''; });
          } else {
            const obs = new IntersectionObserver(([wpis]) => {
              if (wpis.isIntersecting) { el.classList.add('w-polu'); obs.disconnect(); }
            }, { threshold: 0 });
            obs.observe(el);
          }
        });
      };

      // ── 4. Płynne przewijanie do sekcji (przechwytuje przed ViewTransitions) ────
      const inicjujPlynnePrzew = () => {
        document.addEventListener('click', (e: MouseEvent) => {
          const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
          if (!link) return;
          const href = link.getAttribute('href') ?? '';
          const hashIdx = href.indexOf('#');
          if (hashIdx < 0) return;
          const id = href.slice(hashIdx + 1);
          if (!id) return;
          const target = document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          const header = document.querySelector<HTMLElement>('header');
          const offset = header ? header.offsetHeight + 8 : 88;
          window.scrollTo({
            top: target.getBoundingClientRect().top + window.scrollY - offset,
            behavior: 'smooth',
          });
          history.pushState(null, '', `#${id}`);
          const details = document.querySelector<HTMLDetailsElement>('header details');
          if (details) details.open = false;
        }, true); // capture: true — odpal przed Astro ViewTransitions
      };

      // ── Inicjalizacja ─────────────────────────────────────────────────────────
      const init = () => {
        zaobserwujLinie();
        inicjujAktywnyLink();
        inicjujReveal();
      };

      inicjujPlynnePrzew(); // tylko raz — listener przeżywa ViewTransitions
      init();
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
