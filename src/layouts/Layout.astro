---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Kurtyna from '../components/Kurtyna.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Dane strukturalne -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Axiom',
      description: 'Projektowanie i budowa stron internetowych — pełny serwis: projekt, kod, domena i hosting na Cloudflare.',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Polska',
      },
      url: canonicalURL,
    })} />

    <ViewTransitions />
    <!-- Kurtyna: ukryj przez CSS zanim JS wystartuje (tylko powrót / reload) -->
    <script is:inline>
      if(sessionStorage.getItem('kurtyna-v2')){document.documentElement.classList.add('kurtyna-skip')}
    </script>
  </head>
  <body>
    <Kurtyna />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:bg-anthracite focus:text-cream focus:px-4 focus:py-2"
    >
      Przejdź do treści
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <CookieBanner />
    <Footer />

    <script>
      // ── 1. Linea tracta — kreślenie konturów SVG przy wejściu w widok ──────────
      // WAŻNE: obserwujemy element <svg>, nie jego dzieci (rect/line/path).
      // Elementy potomne SVG używają własnego układu współrzędnych — IntersectionObserver
      // nie wylicza dla nich poprawnego bounding-box w Safari i nie odpala przy scrollu w górę.
      const obserwatorLinii = new IntersectionObserver(
        (wpisy) => {
          for (const wpis of wpisy) {
            if (wpis.isIntersecting) {
              wpis.target.querySelectorAll<Element>('.linea-tracta').forEach((el) =>
                el.classList.add('in-conspectu')
              );
              obserwatorLinii.unobserve(wpis.target);
            }
          }
        },
        { threshold: 0.05 }
      );

      const zaobserwujLinie = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        for (const el of document.querySelectorAll<Element>('.linea-tracta:not(.in-conspectu)')) {
          const kontener: Element = el.closest('svg') ?? el;
          if (!kontener.hasAttribute('data-obs')) {
            kontener.setAttribute('data-obs', '1');
            obserwatorLinii.observe(kontener);
          }
        }
      };

      // ── 2. Aktywna sekcja w nawigacji ─────────────────────────────────────────
      const inicjujAktywnyLink = () => {
        const sekcje = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
        const linki = Array.from(document.querySelectorAll<HTMLAnchorElement>('header nav a[href]'));
        if (!sekcje.length || !linki.length) return;

        const obsNav = new IntersectionObserver((wpisy) => {
          for (const wpis of wpisy) {
            if (wpis.isIntersecting) {
              const id = wpis.target.id;
              linki.forEach((link) => {
                const href = link.getAttribute('href') ?? '';
                link.classList.toggle('nav-aktywny', href === `#${id}` || href === `/#${id}`);
              });
            }
          }
        }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });

        sekcje.forEach((s) => obsNav.observe(s));
      };

      // ── 3. Reveal nagłówków — obukierunkowo: animuje przy wejściu, resetuje przy wyjściu ─
      const inicjujReveal = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll<HTMLElement>('section h2:not(.h-reveal)').forEach((el) => {
          el.classList.add('h-reveal');
          const rect = el.getBoundingClientRect();
          const inView = rect.top < window.innerHeight && rect.bottom > 0;
          const powyżej = rect.bottom < 0; // Nagłówek całkowicie powyżej viewportu
          if (inView || powyżej) {
            // Pokaż natychmiast bez animacji
            el.style.transition = 'none';
            el.classList.add('w-polu');
            requestAnimationFrame(() => { el.style.transition = ''; });
          } else {
            // Poniżej viewportu — obukierunkowy toggle przy scrollu
            const obs = new IntersectionObserver(([wpis]) => {
              el.classList.toggle('w-polu', wpis.isIntersecting);
            }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
            obs.observe(el);
          }
        });
      };

      // ── 4. Płynne przewijanie do sekcji z własnym easingiem ───────────────────
      const inicjujPlynnePrzew = () => {
        const easeInOutQuart = (t: number) =>
          t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;

        const przewijDo = (cel: HTMLElement) => {
          const header = document.querySelector<HTMLElement>('header');
          const offset = header ? header.offsetHeight + 8 : 88;
          const docelY = cel.getBoundingClientRect().top + window.scrollY - offset;
          const startY = window.scrollY;
          const roznica = docelY - startY;
          if (Math.abs(roznica) < 10) return;
          const czas = Math.min(Math.max(Math.abs(roznica) * 0.4, 600), 1000);

          const html = document.documentElement;
          html.style.scrollBehavior = 'auto';
          let tStart: number | null = null;
          const krok = (ts: number) => {
            if (tStart === null) tStart = ts;
            const elapsed = ts - tStart;
            const t = Math.min(elapsed / czas, 1);
            window.scrollTo(0, startY + roznica * easeInOutQuart(t));
            if (t < 1) requestAnimationFrame(krok);
            else html.style.scrollBehavior = '';
          };
          requestAnimationFrame(krok);
        };

        document.addEventListener('click', (e: MouseEvent) => {
          const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
          if (!link) return;
          const href = link.getAttribute('href') ?? '';
          const hashIdx = href.indexOf('#');
          if (hashIdx < 0) return;
          const id = href.slice(hashIdx + 1);
          if (!id) return;
          const cel = document.getElementById(id);
          if (!cel) return;
          e.preventDefault();
          przewijDo(cel);
          history.pushState(null, '', `#${id}`);
          const details = document.querySelector<HTMLDetailsElement>('header details');
          if (details) details.open = false;
          // Wizualny sygnał sekcji docelowej
          cel.classList.remove('cel-nawigacji');
          void (cel as HTMLElement).offsetWidth; // reflow → restart animacji
          cel.classList.add('cel-nawigacji');
        }, true); // capture: true — odpal przed Astro ViewTransitions
      };

      // ── 5. Magnetyczne przyciski — lekkie przyciąganie kursora przy hover ────────
      const inicjujMagnes = () => {
        if (window.matchMedia('(hover: none)').matches) return;
        const selektor = '.btn-primary:not([data-magnes]), .btn-secondary:not([data-magnes])';
        document.querySelectorAll<HTMLElement>(selektor).forEach((el) => {
          el.setAttribute('data-magnes', '1');
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const dx = (e.clientX - rect.left - rect.width / 2) * 0.3;
            const dy = (e.clientY - rect.top - rect.height / 2) * 0.3;
            el.style.transition = 'background-color 0.2s, color 0.2s, border-color 0.2s';
            el.style.transform = `translate(${dx}px, ${dy}px)`;
          });
          el.addEventListener('mouseleave', () => {
            el.style.transition =
              'background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.65s cubic-bezier(0.23,1,0.32,1)';
            el.style.transform = '';
          });
        });
      };

      // ── 6. Scroll velocity — header zwęża się przy szybkim scrollu ────────────
      const inicjujScrollVelocity = () => {
        const header = document.querySelector<HTMLElement>('header');
        if (!header) return;
        let lastY = window.scrollY, lastT = Date.now();
        let tid: ReturnType<typeof setTimeout>;
        window.addEventListener('scroll', () => {
          const now = Date.now();
          const vel = Math.abs(window.scrollY - lastY) / Math.max(now - lastT, 1);
          header.classList.toggle('scroll-szybki', vel > 1.2);
          clearTimeout(tid);
          tid = setTimeout(() => header.classList.remove('scroll-szybki'), 180);
          lastY = window.scrollY;
          lastT = now;
        }, { passive: true });
      };

      // ── Inicjalizacja ─────────────────────────────────────────────────────────
      const init = () => {
        zaobserwujLinie();
        inicjujAktywnyLink();
        inicjujReveal();
        inicjujMagnes();
      };

      inicjujPlynnePrzew();    // tylko raz — listener przeżywa ViewTransitions
      inicjujScrollVelocity(); // tylko raz — scroll listener globalny
      init();
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
