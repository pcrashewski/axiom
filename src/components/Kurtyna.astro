---
import Mark from './Mark.astro';
---

<div
  id="kurtyna"
  class="fixed inset-0 z-[999] flex flex-col items-center justify-center bg-cream gap-5"
  aria-hidden="true"
>
  <Mark class="h-16 w-16" />
  <p class="eyebrow tracking-[0.35em] text-warm-gray">Opifex</p>
</div>

<script>
  const kurtyna = document.getElementById('kurtyna');
  if (kurtyna) {
    if (sessionStorage.getItem('kurtyna-ok')) {
      kurtyna.remove();
    } else {
      sessionStorage.setItem('kurtyna-ok', '1');
      document.documentElement.classList.add('kurtyna-skip');
      setTimeout(() => {
        kurtyna.classList.add('kurtyna-zjazd');
        // fallback: usuń po zakończeniu animacji lub po 1s, cokolwiek nastąpi pierwsze
        const usun = () => kurtyna.remove();
        kurtyna.addEventListener('transitionend', usun, { once: true });
        setTimeout(usun, 1000);
      }, 850);
    }
  }
</script>
