---
import Mark from './Mark.astro';
---

<div
  id="kurtyna"
  class="fixed inset-0 z-[999] flex flex-col items-center justify-center gap-5 bg-[#040b12]"
  aria-hidden="true"
>
  <Mark class="h-16 w-16" />
  <p class="eyebrow tracking-[0.35em] text-warm-gray">AXIOM</p>
</div>

<script>
  const inicjalizuj = () => {
    const k = document.getElementById('kurtyna');
    if (!k) return;

    if (sessionStorage.getItem('kurtyna-v2')) {
      k.remove();
      return;
    }

    sessionStorage.setItem('kurtyna-v2', '1');
    setTimeout(() => {
      k.classList.add('kurtyna-zjazd');
      const usun = () => { if (k.isConnected) k.remove(); };
      k.addEventListener('transitionend', usun, { once: true });
      setTimeout(usun, 1100);
    }, 1600);
  };

  inicjalizuj();
  document.addEventListener('astro:after-swap', inicjalizuj);
</script>
