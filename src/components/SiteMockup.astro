---
interface Props {
  variant?: 'cms' | 'gallery';
  accent?: string;
  label: string;
  class?: string;
}
const { variant = 'cms', accent = '#C9764A', label, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 480 320"
  xmlns="http://www.w3.org/2000/svg"
  class={`mockup-svg w-full h-auto ${className}`}
  role="img"
  aria-label={label}
>
  <rect x="0.75" y="0.75" width="478.5" height="318.5" fill="none" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0s" />
  <!-- pasek przeglądarki -->
  <line x1="0.75" y1="36" x2="479.25" y2="36" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.05s" />
  <circle cx="20" cy="18" r="4" fill="none" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.1s" />
  <circle cx="36" cy="18" r="4" fill="none" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.12s" />
  <circle cx="52" cy="18" r="4" fill="none" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.14s" />
  <line x1="96" y1="18" x2="384" y2="18" stroke="#8C8479" stroke-width="1.5" stroke-dasharray="2 4" pathLength="1" class="linea-tracta" style="--mora: 0.16s" />

  <!-- nagłówek treści -->
  <rect x="32" y="64" width="170" height="16" fill={accent} />
  <line x1="32" y1="100" x2="280" y2="100" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.2s" />
  <line x1="32" y1="116" x2="240" y2="116" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.24s" />
  <rect x="32" y="140" width="120" height="36" fill="none" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.28s" />

  {variant === 'cms' ? (
    <>
      <!-- karty treści / panel CMS -->
      <rect x="32" y="200" width="135" height="92" fill="none" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.32s" />
      <rect x="180" y="200" width="135" height="92" fill="none" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.36s" />
      <rect x="328" y="200" width="120" height="92" fill="none" stroke="#8C8479" stroke-width="1.5" stroke-dasharray="3 4" pathLength="1" class="linea-tracta" style="--mora: 0.4s" />
      <line x1="44" y1="220" x2="150" y2="220" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.44s" />
      <line x1="44" y1="236" x2="130" y2="236" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.46s" />
      <line x1="192" y1="220" x2="298" y2="220" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.48s" />
      <line x1="192" y1="236" x2="278" y2="236" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.5s" />
    </>
  ) : (
    <>
      <!-- galeria realizacji -->
      <rect x="32" y="200" width="96" height="92" fill="none" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.32s" />
      <rect x="140" y="200" width="96" height="92" fill={accent} fill-opacity="0.15" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.36s" />
      <rect x="248" y="200" width="96" height="92" fill="none" stroke="#1C1B1A" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.4s" />
      <rect x="356" y="200" width="92" height="92" fill="none" stroke="#8C8479" stroke-width="1.5" stroke-dasharray="3 4" pathLength="1" class="linea-tracta" style="--mora: 0.44s" />
      <line x1="48" y1="232" x2="112" y2="264" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.48s" />
      <line x1="112" y1="232" x2="48" y2="264" stroke="#8C8479" stroke-width="1.5" pathLength="1" class="linea-tracta" style="--mora: 0.5s" />
    </>
  )}
</svg>
