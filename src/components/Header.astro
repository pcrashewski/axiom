---
import Mark from './Mark.astro';

const navLinks = [
  { href: '/#uslugi', label: 'Usługi' },
  { href: '/#realizacje', label: 'Realizacje' },
  { href: '/#proces', label: 'Proces' },
  { href: '/#cennik', label: 'Cennik' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#07121d]/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-start justify-between gap-6 px-6 py-5">
    <a href="/" class="group flex items-center gap-3">
      <Mark class="h-8 w-8 shrink-0 sm:h-9 sm:w-9" />
      <div>
        <span class="text-2xl font-semibold tracking-[-0.06em] text-anthracite sm:text-3xl">
          Axiom
        </span>
        <p class="mt-1 max-w-xs text-[10px] leading-snug text-warm-gray sm:text-xs">
          Web systems · product polish · delivery
        </p>
      </div>
    </a>

    <nav class="hidden items-center gap-8 pt-2 md:flex" aria-label="Nawigacja główna">
      {navLinks.map((link) => (
        <a href={link.href} class="eyebrow transition-colors duration-200 hover:text-terracotta">
          {link.label}
        </a>
      ))}
      <a href="/umowa" class="eyebrow transition-colors duration-200 hover:text-terracotta">
        Umowa
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="list-none cursor-pointer pt-2 text-[11px] uppercase tracking-[0.2em] text-anthracite [&::-webkit-details-marker]:hidden"
        aria-label="Otwórz menu"
      >
        <span class="inline-flex items-center gap-2">
          <Mark class="h-5 w-5" />
          Menu
        </span>
      </summary>
      <nav class="absolute right-0 z-10 mt-3 w-48 border border-white/10 bg-[#081827] px-5 py-4 shadow-[0_20px_40px_rgba(5,11,22,0.8)]">
        {navLinks.map((link) => (
          <a href={link.href} class="eyebrow block py-2 transition-colors duration-200 hover:text-terracotta">
            {link.label}
          </a>
        ))}
        <a href="/umowa" class="eyebrow block py-2 transition-colors duration-200 hover:text-terracotta">
          Umowa
        </a>
      </nav>
    </details>
  </div>
</header>
