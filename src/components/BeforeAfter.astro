      <rect x="424" y="351" width="146" height="38" rx="1" fill="#E8E2D8"/>
      <rect y="392" width="600" height="8" fill="#1D2327"/>
    </svg>

    <!-- ══ PO: czysty layout Astro / Axiom ═══════════════════════════════════ -->
    <div class="ba-po absolute inset-0">
      <svg
        viewBox="0 0 600 400"
        xmlns="http://www.w3.org/2000/svg"
        class="absolute inset-0 h-full w-full"
        aria-hidden="true"
      >
        <rect width="600" height="400" fill="#07121D"/>
        <defs>
          <pattern id="ba-siatka" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M48 0 L0 0 0 48" fill="none" stroke="#9DB0C7" stroke-opacity="0.12" stroke-width="1"/>
          </pattern>
        </defs>
        <rect x="0" y="56" width="600" height="220" fill="url(#ba-siatka)"/>

        <rect width="600" height="1" y="55" fill="rgba(157,176,199,0.2)"/>
        <rect x="18" y="18" width="22" height="22" rx="6" fill="rgba(110,231,255,0.15)"/>
        <rect x="30" y="30" width="22" height="22" rx="6" fill="#6EE7FF"/>
        <rect x="58" y="20" width="72" height="10" rx="2" fill="#EAF5FF"/>
        <rect x="58" y="34" width="120" height="7" rx="1" fill="#9DB0C7" opacity="0.6"/>
        <rect x="390" y="24" width="38" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="438" y="24" width="44" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="490" y="24" width="36" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="524" y="18" width="58" height="22" rx="8" fill="#6EE7FF"/>

        <rect x="32" y="82" width="120" height="8" rx="1" fill="#6EE7FF" opacity="0.8"/>
        <rect x="32" y="98" width="330" height="22" rx="3" fill="#EAF5FF"/>
        <rect x="32" y="126" width="270" height="22" rx="3" fill="#EAF5FF" opacity="0.9"/>
        <rect x="32" y="160" width="270" height="9" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="32" y="173" width="248" height="9" rx="1" fill="#9DB0C7" opacity="0.65"/>
        <rect x="32" y="196" width="108" height="28" rx="8" fill="#6EE7FF"/>
        <rect x="150" y="196" width="108" height="28" rx="8" fill="none" stroke="#EAF5FF" stroke-width="1.2"/>
        <rect x="405" y="82" width="120" height="110" rx="20" fill="rgba(110,231,255,0.08)"/>
        <rect x="438" y="120" width="76" height="76" rx="18" fill="#8AA9FF" opacity="0.2"/>

        <rect width="600" height="1" y="248" fill="rgba(157,176,199,0.2)"/>
        <rect x="32" y="260" width="64" height="7" rx="1" fill="#6EE7FF" opacity="0.8"/>
        <rect x="32" y="273" width="200" height="16" rx="2" fill="#EAF5FF"/>

        <rect x="32" y="302" width="8" height="8" rx="2" fill="#6EE7FF"/>
        <rect x="48" y="300" width="110" height="10" rx="1" fill="#EAF5FF" opacity="0.85"/>
        <rect x="48" y="314" width="96" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="48" y="325" width="102" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>

        <rect x="216" y="302" width="8" height="8" rx="2" fill="#8AA9FF"/>
        <rect x="232" y="300" width="110" height="10" rx="1" fill="#EAF5FF" opacity="0.85"/>
        <rect x="232" y="314" width="96" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="232" y="325" width="102" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>

        <rect x="400" y="302" width="8" height="8" rx="2" fill="#6EE7FF"/>
        <rect x="416" y="300" width="110" height="10" rx="1" fill="#EAF5FF" opacity="0.85"/>
        <rect x="416" y="314" width="96" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>
        <rect x="416" y="325" width="102" height="7" rx="1" fill="#9DB0C7" opacity="0.7"/>

        <rect width="600" height="1" y="372" fill="rgba(157,176,199,0.2)"/>
        <rect x="32" y="384" width="12" height="12" rx="3" fill="#EAF5FF" opacity="0.4"/>
        <rect x="48" y="386" width="56" height="6" rx="1" fill="#9DB0C7" opacity="0.6"/>
        <rect x="430" y="386" width="140" height="6" rx="1" fill="#9DB0C7" opacity="0.45"/>
      </svg>
    </div>

    <div
      class="pointer-events-none absolute inset-y-0 z-10"
      style="left: var(--poz); width: 2px; background: rgba(255,255,255,0.95); box-shadow: 0 0 16px rgba(110, 231, 255, 0.45);"
    ></div>

    <div
      class="pointer-events-none absolute top-1/2 z-10 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[#0B1320] shadow-[0_10px_30px_rgba(110,231,255,0.25)]"
      style="left: var(--poz)"
    >
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 5H17M1 5L5 1M1 5L5 9M17 5L13 1M17 5L13 9" stroke="#EAF5FF" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>

    <span class="pointer-events-none absolute left-3 top-3 z-10 rounded-full border border-white/10 bg-[#0B1320]/80 px-2 py-1 text-[10px] uppercase tracking-[0.16em] text-cream">
      {etykietaPo}
    </span>
    <span class="pointer-events-none absolute right-3 top-3 z-10 rounded-full border border-white/10 bg-[#0B1320]/60 px-2 py-1 text-[10px] uppercase tracking-[0.16em] text-cream">
      {etykietaPrzed}
    </span>

    <input
      type="range"
      min="0"
      max="100"
      value="48"
      class="absolute inset-0 z-20 h-full w-full opacity-0"
      style="cursor: ew-resize !important;"
      aria-label="Przeciągnij, aby porównać wersję przed i po migracji"
    />
  </div>
  <figcaption class="mt-3 text-center uppercase tracking-[0.18em] text-[10px] text-warm-gray/70">
    Przeciągnij suwak — migracja strony parafii z WordPress na Astro
  </figcaption>
</figure>

<style>
  .ba-po {
    clip-path: inset(0 calc(100% - var(--poz, 48%)) 0 0);
  }
</style>

<script>
  const inicjujBA = () => {
    document.querySelectorAll<HTMLInputElement>('.ba-kontener input[type=range]').forEach((input) => {
      const kontener = input.closest<HTMLElement>('.ba-kontener');
      if (!kontener) return;
      input.addEventListener('input', () => {
        kontener.style.setProperty('--poz', `${input.value}%`);
      });
    });
  };
  inicjujBA();
  document.addEventListener('astro:page-load', inicjujBA);
</script>
