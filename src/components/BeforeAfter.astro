      <rect x="110" y="152" width="410" height="16" rx="2" fill="rgba(255,255,255,0.78)"/>
      <rect x="170" y="175" width="270" height="11" rx="2" fill="rgba(255,255,255,0.6)"/>
      <rect x="220" y="191" width="155" height="18" rx="3" fill="#11466C" opacity="0.9"/>
      <rect x="8" y="160" width="28" height="28" rx="14" fill="rgba(0,0,0,0.34)"/>
