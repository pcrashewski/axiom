      <circle cx="266" cy="222" r="5" fill="#D7D1C8"/>
      <circle cx="284" cy="222" r="6" fill="#11466C"/>
      <circle cx="302" cy="222" r="5" fill="#D7D1C8"/>
      <circle cx="320" cy="222" r="5" fill="#D7D1C8"/>

      <rect x="18" y="244" width="378" height="1" fill="#D7CFC3"/>
      <rect x="18" y="256" width="82" height="9" rx="1" fill="#C3B9AE"/>
      <rect x="18" y="270" width="290" height="13" rx="2" fill="#90877F"/>
      <rect x="18" y="289" width="360" height="7" rx="1" fill="#C7BFB4"/>
      <rect x="18" y="301" width="340" height="7" rx="1" fill="#C7BFB4"/>
      <rect x="18" y="313" width="350" height="7" rx="1" fill="#C7BFB4"/>
      <rect x="18" y="325" width="300" height="7" rx="1" fill="#C7BFB4"/>
