    <svg
      viewBox="0 0 600 400"
      xmlns="http://www.w3.org/2000/svg"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    >
      <rect width="600" height="400" fill="#F0EFEA"/>
      <rect width="600" height="20" fill="#1D2327"/>
      <rect x="8" y="6" width="8" height="8" rx="1" fill="#5B646C"/>
