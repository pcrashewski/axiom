---
interface Props {
  etykietaPrzed?: string;
  etykietaPo?: string;
}
const {
  etykietaPrzed = 'WordPress — przed',
  etykietaPo = 'Astro — po migracji',
} = Astro.props;
---

<figure class="w-full">
  <div
    class="ba-kontener relative overflow-hidden rounded-sm border border-warm-gray/20"
    style="aspect-ratio: 3/2; --poz: 48%"
  >
    <!-- ══ PRZED: ciężki, zatłoczony layout WordPress ══════════════════════════ -->
    <svg
      viewBox="0 0 600 400"
      xmlns="http://www.w3.org/2000/svg"
      class="absolute inset-0 w-full h-full"
      aria-hidden="true"
    >
      <!-- Tło strony -->
      <rect width="600" height="400" fill="#e8e4dc"/>

      <!-- ── Admin bar WordPress ── -->
      <rect width="600" height="20" fill="#1d2327"/>
      <rect x="8" y="6" width="8" height="8" rx="1" fill="#3c434a"/>
      <rect x="22" y="7" width="44" height="6" rx="1" fill="#3c434a"/>
      <rect x="72" y="7" width="36" height="6" rx="1" fill="#3c434a"/>
      <rect x="114" y="7" width="50" height="6" rx="1" fill="#3c434a"/>
      <rect x="480" y="7" width="60" height="6" rx="1" fill="#3c434a"/>
      <rect x="546" y="7" width="46" height="6" rx="1" fill="#3c434a"/>

      <!-- ── Nagłówek: generic logo + wielki tytuł ── -->
      <rect y="20" width="600" height="70" fill="#f0ece4"/>
      <!-- Logo placeholder: okrąg + kwadrat (niespójne) -->
      <rect x="16" y="30" width="50" height="50" rx="25" fill="#c8c2b8"/>
      <rect x="16" y="30" width="50" height="50" rx="25" fill="none" stroke="#b0a898" stroke-width="1.5"/>
      <rect x="28" y="44" width="26" height="22" rx="2" fill="#f0ece4" opacity="0.8"/>
      <!-- Wielki tytuł parafii w Serif -->
      <rect x="78" y="34" width="200" height="14" rx="2" fill="#7a7268"/>
      <rect x="78" y="52" width="160" height="11" rx="2" fill="#a09890"/>
      <rect x="78" y="67" width="130" height="8" rx="2" fill="#b8b2a8"/>
      <!-- Ozdobna linia pod nagłówkiem -->
      <line x1="0" y1="90" x2="600" y2="90" stroke="#c8c0b4" stroke-width="2"/>

      <!-- ── Nawigacja: szeroka, ciemnoniebieska, 7 pozycji ── -->
      <rect y="90" width="600" height="36" fill="#1b4f72"/>
      <!-- Active item podświetlony -->
      <rect y="90" width="80" height="36" fill="#154360"/>
      <rect x="6" y="99" width="68" height="18" rx="1" fill="#2e86c1" opacity="0.8"/>
      <!-- Pozostałe linki -->
      <rect x="88" y="102" width="54" height="12" rx="1" fill="#7fb3d3" opacity="0.7"/>
      <rect x="150" y="102" width="66" height="12" rx="1" fill="#7fb3d3" opacity="0.7"/>
      <rect x="224" y="102" width="54" height="12" rx="1" fill="#7fb3d3" opacity="0.7"/>
      <rect x="286" y="102" width="60" height="12" rx="1" fill="#7fb3d3" opacity="0.7"/>
      <rect x="354" y="102" width="50" height="12" rx="1" fill="#7fb3d3" opacity="0.7"/>
      <rect x="412" y="102" width="44" height="12" rx="1" fill="#7fb3d3" opacity="0.7"/>
      <!-- Szukaj po prawej -->
      <rect x="558" y="100" width="34" height="16" rx="2" fill="#154360"/>

      <!-- ── Hero: duży slider z gradientem ── -->
      <rect y="126" width="600" height="100" fill="#c8c2b8"/>
      <!-- Ciemne sfotografowane zdjęcie (symulacja) -->
      <rect y="126" width="600" height="100" fill="#b8b4ac"/>
      <rect y="166" width="600" height="60" fill="rgba(0,0,0,0.35)"/>
      <!-- Tekst na sliderze -->
      <rect x="100" y="150" width="400" height="16" rx="2" fill="rgba(255,255,255,0.75)"/>
      <rect x="160" y="172" width="280" height="11" rx="2" fill="rgba(255,255,255,0.55)"/>
      <rect x="230" y="189" width="140" height="18" rx="3" fill="#1b4f72" opacity="0.9"/>
      <!-- Strzałki slidera -->
      <rect x="8" y="160" width="28" height="28" rx="14" fill="rgba(0,0,0,0.4)"/>
      <rect x="564" y="160" width="28" height="28" rx="14" fill="rgba(0,0,0,0.4)"/>
      <!-- Punkciki -->
      <circle cx="268" cy="220" r="5" fill="#c8c2b8"/>
      <circle cx="282" cy="220" r="6" fill="#1b4f72"/>
      <circle cx="296" cy="220" r="5" fill="#c8c2b8"/>
      <circle cx="310" cy="220" r="5" fill="#c8c2b8"/>

      <!-- ── Treść + sidebar ── -->
      <!-- Kolumna główna -->
      <rect x="14" y="236" width="380" height="1" fill="#d0c8bc"/>
      <rect x="14" y="244" width="80" height="8" rx="1" fill="#c8bcb0"/>
      <rect x="14" y="258" width="280" height="13" rx="2" fill="#8a8278"/>
      <rect x="14" y="276" width="360" height="7" rx="1" fill="#c0b8ae"/>
      <rect x="14" y="287" width="340" height="7" rx="1" fill="#c0b8ae"/>
      <rect x="14" y="298" width="355" height="7" rx="1" fill="#c0b8ae"/>
      <rect x="14" y="309" width="300" height="7" rx="1" fill="#c0b8ae"/>
      <rect x="14" y="324" width="80" height="20" rx="2" fill="#1b4f72"/>

      <!-- Sidebar -->
      <rect x="406" y="234" width="182" height="160" fill="#ede9e1"/>
      <!-- Widget 1 -->
      <rect x="406" y="234" width="182" height="22" fill="#ddd9cf"/>
      <rect x="416" y="242" width="120" height="8" rx="1" fill="#8a8278"/>
      <rect x="414" y="262" width="166" height="8" rx="1" fill="#c8bcb0"/>
      <rect x="414" y="274" width="150" height="8" rx="1" fill="#c8bcb0"/>
      <rect x="414" y="286" width="158" height="8" rx="1" fill="#c8bcb0"/>
      <rect x="414" y="298" width="140" height="8" rx="1" fill="#c8bcb0"/>
      <!-- Widget 2 -->
      <rect x="406" y="315" width="182" height="22" fill="#ddd9cf"/>
      <rect x="416" y="323" width="100" height="8" rx="1" fill="#8a8278"/>
      <rect x="414" y="347" width="166" height="38" rx="1" fill="#e5e1d8"/>

      <!-- ── Footer ── -->
      <rect y="392" width="600" height="8" fill="#1d2327"/>
    </svg>

    <!-- ══ PO: czysty layout Astro / Opifex ═══════════════════════════════════ -->
    <div class="ba-po absolute inset-0">
      <svg
        viewBox="0 0 600 400"
        xmlns="http://www.w3.org/2000/svg"
        class="absolute inset-0 w-full h-full"
        aria-hidden="true"
      >
        <!-- Tło — czysty krem -->
        <rect width="600" height="400" fill="#F7F2E9"/>

        <!-- Wzór siatki (jak w Hero) -->
        <defs>
          <pattern id="ba-siatka" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M48 0 L0 0 0 48" fill="none" stroke="#8C8479" stroke-opacity="0.07" stroke-width="1"/>
          </pattern>
        </defs>
        <rect x="0" y="56" width="600" height="200" fill="url(#ba-siatka)"/>

        <!-- ── Nawigacja: cienka, przyklejona ── -->
        <rect width="600" height="1" y="55" fill="#8C847930"/>
        <!-- Mark — dwa kwadraty -->
        <rect x="16" y="18" width="22" height="22" fill="#1C1B1A"/>
        <rect x="24" y="26" width="22" height="22" fill="#C9764A" opacity="0.88"/>
        <!-- Wordmark -->
        <rect x="54" y="20" width="56" height="10" rx="1" fill="#1C1B1A"/>
        <rect x="54" y="34" width="124" height="7" rx="1" fill="#8C8479" opacity="0.5"/>
        <!-- Linki nav -->
        <rect x="380" y="24" width="36" height="7" rx="1" fill="#8C8479" opacity="0.6"/>
        <rect x="426" y="24" width="42" height="7" rx="1" fill="#8C8479" opacity="0.6"/>
        <rect x="478" y="24" width="36" height="7" rx="1" fill="#8C8479" opacity="0.6"/>
        <!-- CTA w navie -->
        <rect x="522" y="18" width="62" height="20" fill="#1C1B1A"/>

        <!-- ── Hero: duże, powietrzne ── -->
        <!-- Eyebrow -->
        <rect x="32" y="82" width="116" height="8" rx="1" fill="#C9764A" opacity="0.75"/>
        <!-- Główny nagłówek: 2 linie, duże -->
        <rect x="32" y="98" width="320" height="22" rx="2" fill="#1C1B1A"/>
        <rect x="32" y="126" width="270" height="22" rx="2" fill="#1C1B1A"/>
        <!-- Podtytuł -->
        <rect x="32" y="160" width="270" height="9" rx="1" fill="#8C8479" opacity="0.6"/>
        <rect x="32" y="173" width="240" height="9" rx="1" fill="#8C8479" opacity="0.6"/>
        <!-- Dwa CTA -->
        <rect x="32" y="196" width="104" height="26" fill="#1C1B1A"/>
        <rect x="144" y="196" width="100" height="26" fill="none" stroke="#1C1B1A" stroke-width="1"/>
        <!-- Mark-logotyp po prawej — duży, dekoracyjny -->
        <rect x="380" y="76" width="88" height="88" fill="#1C1B1A" opacity="0.05"/>
        <rect x="424" y="120" width="88" height="88" fill="#C9764A" opacity="0.10"/>

        <!-- ── Hairline sekcji ── -->
        <rect width="600" height="1" y="248" fill="#8C847930"/>

        <!-- ── Usługi: 3 kafle, dużo powietrza ── -->
        <!-- Eyebrow -->
        <rect x="32" y="260" width="58" height="7" rx="1" fill="#C9764A" opacity="0.7"/>
        <!-- Heading -->
        <rect x="32" y="273" width="200" height="16" rx="2" fill="#1C1B1A"/>

        <!-- Kafle 3×1 -->
        <rect x="32" y="302" width="6" height="6" fill="#C9764A"/>
        <rect x="44" y="300" width="110" height="10" rx="1" fill="#1C1B1A" opacity="0.75"/>
        <rect x="44" y="314" width="96" height="7" rx="1" fill="#8C8479" opacity="0.5"/>
        <rect x="44" y="325" width="100" height="7" rx="1" fill="#8C8479" opacity="0.5"/>

        <rect x="216" y="302" width="6" height="6" fill="#C9764A"/>
        <rect x="228" y="300" width="110" height="10" rx="1" fill="#1C1B1A" opacity="0.75"/>
        <rect x="228" y="314" width="96" height="7" rx="1" fill="#8C8479" opacity="0.5"/>
        <rect x="228" y="325" width="100" height="7" rx="1" fill="#8C8479" opacity="0.5"/>

        <rect x="400" y="302" width="6" height="6" fill="#C9764A"/>
        <rect x="412" y="300" width="110" height="10" rx="1" fill="#1C1B1A" opacity="0.75"/>
        <rect x="412" y="314" width="96" height="7" rx="1" fill="#8C8479" opacity="0.5"/>
        <rect x="412" y="325" width="100" height="7" rx="1" fill="#8C8479" opacity="0.5"/>

        <!-- ── Footer: minimalistyczny ── -->
        <rect width="600" height="1" y="372" fill="#8C847930"/>
        <!-- Mark mały + copyright -->
        <rect x="32" y="383" width="12" height="12" fill="#1C1B1A" opacity="0.4"/>
        <rect x="48" y="386" width="56" height="6" rx="1" fill="#8C8479" opacity="0.5"/>
        <rect x="430" y="386" width="140" height="6" rx="1" fill="#8C8479" opacity="0.4"/>
      </svg>
    </div>

    <!-- Linia podziału z cieniem -->
    <div
      class="pointer-events-none absolute inset-y-0 z-10"
      style="left: var(--poz); width: 2px; background: white; box-shadow: 0 0 8px rgba(0,0,0,0.25);"
    ></div>

    <!-- Uchwyt -->
    <div
      class="pointer-events-none absolute top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 -translate-x-1/2 items-center justify-center rounded-full bg-white shadow-md"
      style="left: var(--poz)"
    >
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 5H17M1 5L5 1M1 5L5 9M17 5L13 1M17 5L13 9" stroke="#1C1B1A" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>

    <!-- Etykiety -->
    <span class="pointer-events-none absolute top-3 left-3 z-10 eyebrow bg-anthracite/70 text-cream px-2 py-1 text-[10px]">
      {etykietaPo}
    </span>
    <span class="pointer-events-none absolute top-3 right-3 z-10 eyebrow bg-anthracite/50 text-cream px-2 py-1 text-[10px]">
      {etykietaPrzed}
    </span>

    <!-- Suwak -->
    <input
      type="range"
      min="0"
      max="100"
      value="48"
      class="absolute inset-0 z-20 h-full w-full opacity-0"
      style="cursor: ew-resize !important;"
      aria-label="Przeciągnij, aby porównać wersję przed i po migracji"
    />
  </div>
  <figcaption class="mt-3 text-center eyebrow text-warm-gray/60">
    Przeciągnij suwak — Parafia Świętych Archaniołów, migracja z WordPress na Astro
  </figcaption>
</figure>

<style>
  .ba-po {
    clip-path: inset(0 calc(100% - var(--poz, 48%)) 0 0);
  }
</style>

<script>
  const inicjujBA = () => {
    document.querySelectorAll<HTMLInputElement>('.ba-kontener input[type=range]').forEach((input) => {
      const kontener = input.closest<HTMLElement>('.ba-kontener');
      if (!kontener) return;
      input.addEventListener('input', () => {
        kontener.style.setProperty('--poz', `${input.value}%`);
      });
    });
  };
  inicjujBA();
  document.addEventListener('astro:page-load', inicjujBA);
</script>
