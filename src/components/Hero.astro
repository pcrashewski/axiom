---
import Mark from './Mark.astro';
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-6 py-20 md:py-32" data-hero>
  <svg class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true" preserveAspectRatio="none">
    <defs>
      <pattern id="hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M48 0 L0 0 0 48" fill="none" stroke="rgba(157,176,199,0.14)" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" />
  </svg>

  <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative grid items-center gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-7">
      <p class="eyebrow mb-6">Strony internetowe — pełny serwis</p>
      <h1 class="max-w-2xl text-4xl font-semibold leading-[1.04] tracking-[-0.06em] text-anthracite sm:text-5xl md:text-6xl">
        Strona zrobiona solidnie
        <span class="text-terracotta">.</span>
        <br />
        Twoja od pierwszego dnia.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-anthracite/80 sm:text-lg">
        Projekt, kod, domena i hosting na Cloudflare — harmonogram ustalamy razem na starcie,
        więc wiesz, czego się spodziewać, zanim zaczniemy. Bez abonamentów u mnie, bez
        zależności od jednej osoby: domena i konto hostingowe od początku należą do Ciebie.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#cennik" class="btn-primary">Zobacz cennik</a>
        <a href="#kontakt" class="btn-secondary">Napisz do mnie</a>
      </div>
    </div>

    <div class="flex md:col-span-5 md:justify-end">
      <div class="relative rounded-[28px] border border-white/10 bg-white/5 p-6 shadow-[0_30px_80px_rgba(6,16,28,0.8)] backdrop-blur-sm">
        <Mark class="h-32 w-32 sm:h-40 sm:w-40" />
        <p class="eyebrow absolute -bottom-7 left-0 whitespace-nowrap sm:-right-1 sm:left-auto">
          Systemy webowe — od 2004
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const inicjujGlow = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const glow = hero?.querySelector<HTMLElement>('.hero-glow');
    if (!hero || !glow) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(hover: none)').matches) return;

    let mx = 50, my = 50, tx = 50, ty = 50;

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      tx = ((e.clientX - rect.left) / rect.width) * 100;
      ty = ((e.clientY - rect.top) / rect.height) * 100;
      glow.style.opacity = '1';
    });
    hero.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const tick = () => {
      mx = lerp(mx, tx, 0.07);
      my = lerp(my, ty, 0.07);
      glow.style.setProperty('background',
        `radial-gradient(380px circle at ${mx}% ${my}%, rgba(110,231,255,0.16), transparent 70%)`
      );
      requestAnimationFrame(tick);
    };
    tick();
  };

  inicjujGlow();
  document.addEventListener('astro:page-load', inicjujGlow);
</script>
