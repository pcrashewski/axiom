---
import GlosaText from './GlosaText.astro';

const steps = [
  {
    numeral: 'I',
    title: 'Brief',
    text: 'Wypełniasz formularz: czego potrzebujesz, jaki masz pomysł, jakie materiały już istnieją.',
  },
  {
    numeral: 'II',
    title: 'Wycena',
    text: 'Dostajesz konkretną cenę na podstawie cennika — bez negocjacji i bez niejasności.',
  },
  {
    numeral: 'III',
    title: 'Przedpłata',
    text: '50% wartości projektu na starcie. Od tego momentu zaczynam pracę.',
  },
  {
    numeral: 'IV',
    title: 'Budowa',
    text: 'Strona powstaje i jest dostępna pod tymczasowym adresem podglądowym — widzisz postępy na żywo.',
  },
  {
    numeral: 'V',
    title: 'Akceptacja',
    text: 'Sprawdzasz treść i wygląd, zgłaszasz poprawki w ramach uzgodnionego zakresu.',
  },
  {
    numeral: 'VI',
    title: 'Wdrożenie',
    text: [
      'Po dopłacie 50% strona trafia na Twoją domenę, a Ty otrzymujesz dostęp do ',
      { term: 'repozytorium', key: 'Repozytorium' },
      ', ',
      { term: 'Cloudflare', key: 'Cloudflare' },
      ' i ',
      { term: 'CMS', key: 'CMS' },
      '.',
    ],
  },
  {
    numeral: 'VII',
    title: 'Wsparcie',
    text: '30 dni na drobne poprawki po starcie — na wypadek, gdyby coś wymagało dotknięcia.',
  },
];
---

<section id="proces" class="bg-anthracite text-cream py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-10 md:mb-12 max-w-md">
      <p class="eyebrow mb-4">Proces</p>
      <h2 class="text-3xl md:text-4xl font-semibold leading-tight text-cream">
        Siedem kroków, jeden harmonogram
      </h2>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 md:gap-x-16">
      {steps.map((step, i) => {
        const border = i === 0 ? '' : i === 1 ? 'border-t border-cream/15 md:border-t-0' : 'border-t border-cream/15';
        return (
        <li class={`grid grid-cols-12 gap-6 items-baseline py-5 ${border}`}>
          <span
            class="col-span-3 sm:col-span-2 font-display text-3xl sm:text-4xl font-semibold text-cream/15 leading-none"
            aria-hidden="true"
          >
            {step.numeral}
          </span>
          <div class="col-span-9 sm:col-span-10">
            <h3 class="text-lg sm:text-xl font-semibold mb-1 text-cream">{step.title}</h3>
            <p class="text-cream/75 leading-relaxed max-w-xl">
              {Array.isArray(step.text) ? <GlosaText parts={step.text} /> : step.text}
            </p>
          </div>
        </li>
        );
      })}
    </ol>
  </div>
</section>
